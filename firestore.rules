rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isVerifiedHaloUser() {
      return request.auth != null
             && request.auth.token.email_verified == true;
    }

    function isHaloLicenseAdmin() {
      return request.auth != null
             && request.auth.uid == "ERaS9esf2wZK46SM70TbShsP68e2";
    }

    function managedLicenseDeviceLimit() {
      return ('deviceLimit' in resource.data
              && resource.data.deviceLimit is int
              && resource.data.deviceLimit > 0)
             ? resource.data.deviceLimit
             : 1;
    }

    function canReadManagedLicense() {
      return isVerifiedHaloUser()
             && (
               !('bound' in resource.data)
               || resource.data.bound != true
               || (
                 'boundUid' in resource.data
                 && resource.data.boundUid == request.auth.uid
               )
             );
    }

    function canUpdateManagedLicenseDevices() {
      return isVerifiedHaloUser()
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'bound',
               'boundUid',
               'boundEmail',
               'boundDeviceId',
               'boundDeviceIds',
               'boundAt',
               'updatedAt'
             ])
             && request.resource.data.bound == true
             && request.resource.data.boundUid == request.auth.uid
             && request.resource.data.boundEmail is string
             && request.resource.data.boundDeviceId is string
             && request.resource.data.boundDeviceIds is list
             && request.resource.data.boundDeviceIds.size() <= managedLicenseDeviceLimit()
             && (
               !('bound' in resource.data)
               || resource.data.bound != true
               || (
                 'boundUid' in resource.data
                 && resource.data.boundUid == request.auth.uid
               )
             );
    }

    // One immutable trial claim per Firebase account.
    match /haloTrialClaims/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.auth.token.email_verified == true
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.version == 1;

      allow update, delete: if false;
    }

    // Public, website-safe issue documents.
    // The Mac client can create a report but cannot edit status or moderation fields.
    // A trusted backend using the Firebase Admin SDK owns later status changes.
    match /feedbackIssues/{issueId} {
      allow read: if true;

      allow create: if isVerifiedHaloUser()
                    && request.resource.data.keys().hasOnly([
                      'schemaVersion',
                      'type',
                      'title',
                      'description',
                      'category',
                      'status',
                      'createdAt',
                      'updatedAt',
                      'appVersion',
                      'appBuild',
                      'platform',
                      'crashRelated'
                    ])
                    && request.resource.data.schemaVersion == 1
                    && request.resource.data.type in ['bug', 'feature', 'crash', 'other']
                    && request.resource.data.title is string
                    && request.resource.data.title.size() >= 4
                    && request.resource.data.title.size() <= 120
                    && request.resource.data.description is string
                    && request.resource.data.description.size() >= 10
                    && request.resource.data.description.size() <= 4000
                    && request.resource.data.category is string
                    && request.resource.data.category.size() <= 80
                    && request.resource.data.status == 'received'
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.appVersion is string
                    && request.resource.data.appVersion.size() <= 40
                    && request.resource.data.appBuild is string
                    && request.resource.data.appBuild.size() <= 40
                    && request.resource.data.platform == 'macOS'
                    && (!('crashRelated' in request.resource.data)
                        || request.resource.data.crashRelated == true);

      allow update, delete: if false;
    }

    // Private companion data for an issue.
    // This collection is never readable by the public website client.
    match /feedbackReports/{reportId} {
      allow read: if false;

      allow create: if isVerifiedHaloUser()
                    && request.resource.data.keys().hasOnly([
                      'schemaVersion',
                      'issueID',
                      'uid',
                      'email',
                      'type',
                      'context',
                      'includeDiagnostics',
                      'createdAt',
                      'previousExecutionCrashed',
                      'diagnostics',
                      'diagnosticsInstallationID'
                    ])
                    && request.resource.data.schemaVersion == 1
                    && request.resource.data.issueID == reportId
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email is string
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.email.size() <= 320
                    && request.resource.data.type in ['bug', 'feature', 'crash', 'other']
                    && request.resource.data.context is string
                    && request.resource.data.context.size() <= 6000
                    && request.resource.data.includeDiagnostics is bool
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.previousExecutionCrashed is bool
                    && (!('diagnosticsInstallationID' in request.resource.data)
                        || request.resource.data.diagnosticsInstallationID is string);

      allow update, delete: if false;
    }

    // Halo-managed license documents.
    // PK_ press keys live in pressLicenses. GK_ giveaway keys should live in
    // giveawayLicenses (Halo also has a client-side fallback for transitional
    // GK records stored in pressLicenses).
    //
    // The Mac app may only bind account/device ownership and adjust the device
    // seat list. License type, status, expiry and deviceLimit remain admin-owned.
    match /pressLicenses/{licenseKey} {
      allow get: if isHaloLicenseAdmin() || canReadManagedLicense();
      allow list: if isHaloLicenseAdmin();
      allow create, delete: if isHaloLicenseAdmin();
      allow update: if isHaloLicenseAdmin() || canUpdateManagedLicenseDevices();
    }

    match /giveawayLicenses/{licenseKey} {
      allow get: if isHaloLicenseAdmin() || canReadManagedLicense();
      allow list: if isHaloLicenseAdmin();
      allow create, delete: if isHaloLicenseAdmin();
      allow update: if isHaloLicenseAdmin() || canUpdateManagedLicenseDevices();
    }

    // Giveaway pools contain unclaimed keys and are admin-only. They must never
    // be readable by the public giveaway page or the Mac client.
    match /giveawayPools/{poolId} {
      allow read, write: if isHaloLicenseAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
