<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleShortVersionString</key>
	<string>0.2.2</string>
	<key>CFBundleVersion</key>
	<string>203</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>Halo uses Apple Music access to show the track you are currently playing and provide playback controls.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Halo reads your calendars to show schedules, holidays, and meeting links. Halo does not modify events.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Halo reads your calendar events when you enable Calendar.</string>
	<key>HaloFirebaseAPIKey</key>
	<string>$(HALO_FIREBASE_API_KEY)</string>
	<key>HaloAppStoreProductIDs</key>
	<array>
		<string>halo_monthly</string>
	</array>
	<key>HaloLicenseSeatProductSlug</key>
	<string>$(HALO_LICENSESEAT_PRODUCT_SLUG)</string>
	<key>HaloLicenseSeatPublishableKey</key>
	<string>$(HALO_LICENSESEAT_PUBLISHABLE_KEY)</string>
	<key>SUFeedURL</key>
	<string>$(HALO_SPARKLE_FEED_URL)</string>
	<key>SUPublicEDKey</key>
	<string>$(HALO_SPARKLE_PUBLIC_KEY)</string>
	<key>SUEnableAutomaticChecks</key>
	<false/>
	<key>SUAutomaticallyUpdate</key>
	<false/>
</dict>
</plist>
