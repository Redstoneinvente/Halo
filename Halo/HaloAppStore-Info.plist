<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleShortVersionString</key>
	<string>0.2.2</string>
	<key>CFBundleVersion</key>
	<string>203</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Halo controls supported media apps such as Apple Music when you use playback controls and reads the current track to display now-playing information.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Halo reads your calendars to show schedules, holidays, and meeting links. Halo does not modify events.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Halo reads your calendar events when you enable Calendar.</string>
	<key>HaloFirebaseAPIKey</key>
	<string>$(HALO_FIREBASE_API_KEY)</string>
	<key>HaloAppStoreProductIDs</key>
	<array>
		<string>halo_monthly</string>
		<string>Halo_Lifetime</string>
	</array>
	<key>HaloLicenseSeatProductSlug</key>
	<string>$(HALO_LICENSESEAT_PRODUCT_SLUG)</string>
	<key>HaloLicenseSeatPublishableKey</key>
	<string>$(HALO_LICENSESEAT_PUBLISHABLE_KEY)</string>
</dict>
</plist>
